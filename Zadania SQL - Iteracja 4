select 
c.customer_id,
c.customer_name,
c.country,
c.acquisition_channel,
count(o.order_id) as orders_count,
count(o.order_id) filter (where o.status = 'paid') as paid_orders,
count(o.order_id) filter (where o.status = 'cancelled') as cancelled_orders,
coalesce(sum(o.total_amount), '0') as total_revenue,
round(avg(o.total_amount), 2) as averaege_order_value,
min(o.order_date) as first_order_date,
max(o.order_date) as last_order_date,
case when count(o.order_id) > 0 
then 'buyer' else 'no orders' end as customer_status
from course.customers c 
left join course.orders o
on c.customer_id = o.customer_id
group by c.customer_id
order by total_revenue desc;


select 
p.product_id,
p.product_name,
p.category,
p.base_price,
coalesce(sum(oi.quantity), '0') as units_sold,
count(oi.order_item_id) as orders_count,
coalesce(sum(oi.quantity * oi.unit_price), '0') as gross_revenue,
avg(oi.unit_price) as average_unit_price,
case when count(oi.order_item_id) = 0 then 'not sold' 
else 'sold' end as sales_status
from course.products p 
left join course.order_items oi 
on p.product_id = oi.product_id 
group by p.product_id
order by gross_revenue desc;

select 
date_trunc('month', o.order_date) as sales_month,
c.country,
count(distinct o.customer_id) as customers_count,
count(o.order_id) as orders_count,
count(o.order_id) filter (where o.status = 'paid') as paid_orders_count,
count(o.order_id) filter (where o.status = 'cancelled') as cancelled_orders_count,
round(sum(o.total_amount), 2) as total_revenue,
round(avg(o.total_amount), 2) as avgerage_order_value
from course.orders o 
join course.customers c 
on c.customer_id = o.customer_id
group by sales_month, c.country
having sum(o.total_amount) > 100
order by sales_month, total_revenue desc;

with customer_totals as (
	select 
		c.customer_id,
		c.customer_name,
		count(o.order_id) as orders_count,
		sum(o.total_amount) as total_revenue
	from course.customers c 
	join course.orders o 
	on c.customer_id = o.customer_id 
	group by c.customer_id
),
average_total_revenue as (
	select 
		avg(total_revenue) as average_total_amount
	from customer_totals 
)
select 
ct.customer_id,
ct.customer_name,
ct.orders_count,
ct.total_revenue
from customer_totals ct
join average_total_revenue atr
on ct.total_revenue > atr.average_total_amount
order by total_revenue desc;

