with items_total_amount as (
	select 
		oi.order_id,
		sum(oi.quantity * oi.unit_price) as items_total_amount
	from course.order_items oi
	group by oi.order_id
)
select 
o.order_id,
c.customer_name,
o.status,
o.total_amount as order_total_amount,
ita.items_total_amount,
o.total_amount - ita.items_total_amount as difference_amount,
case when o.total_amount - ita.items_total_amount <> 0 
then 'different' else 'match' end as amount_check
from course.orders o
join course.customers c
on o.customer_id = c.customer_id
join course.order_items oi
on oi.order_id = o.order_id
join items_total_amount ita
on oi.order_id = ita.order_id;

with customers_with_orders_count as (
	select
		c.acquisition_channel,
		count(distinct o.customer_id) as customers_with_orders_count
	from course.orders o 
	join course.customers c 
	on c.customer_id = o.customer_id
	where o.order_id >= 1
	group by c.acquisition_channel
),
paid_orders_count as (
	select 
		c.acquisition_channel,
		count(o.order_id) as paid_orders_count
	from course.orders o
	join course.customers c 
	on c.customer_id = o.customer_id
	where o.status = 'paid'
	group by c.acquisition_channel 
),
orders_summary as (
	select 
		c.acquisition_channel,
		count(o.order_id) as orders_count,
		sum(o.total_amount) as total_revenue
	from course.orders o
	join course.customers c 
	on c.customer_id = o.customer_id
	group by c.acquisition_channel
),
customers_count as (
	select 
		c.acquisition_channel,
		count(c.customer_id) as customers_count
	from course.customers c
	group by c.acquisition_channel
)
select 
os.acquisition_channel,
cc.customers_count,
cwoc.customers_with_orders_count,
os.orders_count,
poc.paid_orders_count,
os.total_revenue,
round(os.total_revenue / cc.customers_count, 2) as average_revenue_per_customer
from orders_summary os
join paid_orders_count poc
on os.acquisition_channel = poc.acquisition_channel
join customers_with_orders_count cwoc
on cwoc.acquisition_channel = os.acquisition_channel
join customers_count cc
on cc.acquisition_channel = os.acquisition_channel
order by os.total_revenue desc;

select 
p.product_id,
p.product_name,
p.category,
string_agg(distinct c.country, ',') as countries,
sum(oi.quantity) as units_sold,
sum(oi.quantity * oi.unit_price) as total_revenue
from course.products p 
join course.order_items oi 
on oi.product_id = p.product_id 
join course.orders o 
on o.order_id = oi.order_id 
join course.customers c 
on c.customer_id = o.customer_id
where c.country = 'PL' or c.country = 'DE'
