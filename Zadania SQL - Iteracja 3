DROP SCHEMA IF EXISTS course CASCADE;

CREATE SCHEMA course;

create table course.practice (
	customer_id int,
	customer_name text check (length(customer_name) >= 2) not null,
	email text unique,
	country text check (country in ('PL', 'DE', 'FR', 'US')) not null,
	singup_date date not null,
	acquisition_channel text
);

create table course_example.customers (
	customer_id int,
	customer_name text not null,
	email text unique,
	country text check (country in ('PL', 'DE', 'FR', 'US')) not null,
	singup_date date not null,
	acquisition_channel text,
	constraint pk_customers
		primary key (customer_id)
);

create table course_example.products (
	product_id int,
	product_name text not null,
	category text check (category in ('course', 'ebook', 'template', 'consulting')),
	base_price numeric(10, 2) check (base_price >= 0 and base_price <= 10000),
	constraint pk_products
		primary key (product_id)
);

create table if not exists course_example.orders (
	order_id int,
	customer_id int not null,
	order_date date not null,
	status text check (status in ('pending', 'paid', 'cancelled')) default 'pending' not null,
	total_amount numeric(10, 2) check (total_amount >= 0) not null,
	constraint pk_orders 
		primary key (order_id),
	constraint fk_orders_customers 
		foreign key (customer_id)
		references course.customers(customer_id)
);

create table if not exists course_example.order_items (
	order_id int,
	line_number int check (line_number > 0),
	product_id int,
	quantity int check (quantity > 0) not null,
	unit_price numeric(10, 2) check (unit_price >= 0 and unit_price <= 10000) not null,
	constraint pk_order_items 
		primary key (order_id, line_number),
	constraint fk_order_items_orders
		foreign key (order_id)
		references course.orders(order_id),
	constraint fk_order_items_products
		foreign key (product_id)
		references course.products(product_id)
);

