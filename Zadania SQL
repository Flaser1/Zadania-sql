-- Zadania 07
select o.order_id, o.order_date, o.total_amount, c.customer_name, c.country from course.orders o join course.customers c on o.customer_id = c.customer_id;
select oi.order_item_id, oi.order_id, p.product_name, p.category, oi.quantity, oi.unit_price from course.order_items oi join course.products p on oi.product_id = p.product_id;
select o.order_id, o.order_date, p.product_name, oi.quantity, oi.unit_price from course.orders o join course.order_items oi on o.order_id = oi.order_id join course.products p on oi.product_id = p.product_id;
select c.customer_id, c.customer_name, o.order_id, o.total_amount from course.customers c inner join course.orders o on c.customer_id = o.customer_id;
select c.customer_id, c.customer_name, o.order_id, o.total_amount from course.customers c left join course.orders o on c.customer_id = o.customer_id;
-- Różnica może wynikać z tego, że left join pokazał też klientów bez zamówień, a inner join tylko tych z zamówieniami
select o.order_id, o.customer_id, o.order_date, o.status, o.total_amount, c.customer_name from course.orders o inner join course.customers c on o.customer_id = c.customer_id where status = 'paid';
select oi.order_id, oi.product_id, p.product_name from course.order_items oi inner join course.orders o on oi.order_id = o.order_id inner join course.products p on oi.product_id = p.product_id where product_name like '%Course%';
select c.customer_id, c.customer_name, count(*) as liczba_zamówień from course.customers c inner join course.orders o on c.customer_id = o.customer_id group by c.customer_id order by liczba_zamówień desc;
select c.customer_id, c.customer_name, sum(total_amount) from course.customers c inner join course.orders o on c.customer_id = o.customer_id group by c.customer_id;
select oi.product_id, p.product_name, sum(quantity) from course.order_items oi join course.products p on oi.product_id = p.product_id group by oi.product_id, p.product_name;
select c.customer_id, c.customer_name, o.order_id from course.customers c left join course.orders o on c.customer_id = o.customer_id where o.order_id is null;
